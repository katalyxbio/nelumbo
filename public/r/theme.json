  "css": {
    "@layer base": {
      "*": {
        "@apply border-border outline-ring/50": {}
      },
      "body": {
        "@apply bg-background text-foreground": {},
        "font-feature-settings": "\"cv11\", \"ss01\"",
        "-webkit-font-smoothing": "antialiased",
        "text-rendering": "optimizeLegibility"
      }
    },
    "@utility state-layer": {
      "position": "relative",
      "isolation": "isolate",
      "&::after": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0",
        "z-index": "-1",
        "border-radius": "inherit",
        "background-color": "currentColor",
        "opacity": "0",
        "pointer-events": "none",
        "transition": "opacity 160ms var(--ease-standard)"
      },
      "@media (hover: hover)": {
        "&:hover::after": {
          "opacity": "0.07"
        }
      },
      "&:focus-visible::after": {
        "opacity": "0.1"
      },
      "&:active::after": {
        "opacity": "0.12",
        "transition-duration": "40ms"
      },
      "&:disabled::after, &[aria-disabled='true']::after": {
        "opacity": "0"
      }
    },
    "@utility tactile": {
      "transition": "transform 727ms var(--ease-spring-bouncy), box-shadow 200ms var(--ease-standard), background-color 200ms var(--ease-standard), border-color 200ms var(--ease-standard), border-radius 260ms var(--ease-spring), color 200ms var(--ease-standard)",
      "&:active:not(:disabled)": {
        "transform": "scale(0.97)",
        "transition-duration": "90ms",
        "transition-timing-function": "var(--ease-standard)"
      },
      "@media (prefers-reduced-motion: reduce)": {
        "&:active:not(:disabled)": {
          "transform": "none"
        }
      }
    },
    "@utility type-display-lg": {
      "font-size": "3.5rem",
      "line-height": "1.04",
      "letter-spacing": "-0.035em",
      "font-weight": "600"
    },
    "@utility type-display-md": {
      "font-size": "2.75rem",
      "line-height": "1.08",
      "letter-spacing": "-0.03em",
      "font-weight": "600"
    },
    "@utility type-display-sm": {
      "font-size": "2.25rem",
      "line-height": "1.1",
      "letter-spacing": "-0.027em",
      "font-weight": "600"
    },
    "@utility type-headline-lg": {
      "font-size": "2rem",
      "line-height": "1.15",
      "letter-spacing": "-0.024em",
      "font-weight": "600"
    },
    "@utility type-headline-md": {
